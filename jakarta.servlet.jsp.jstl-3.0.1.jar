<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="userMS.model.beans.UsersBeans, sayukiGame.model.beans.Sayuki_Sakota" %>
<%
    // ユーザー情報とゲームデータの取得
    UsersBeans user = (UsersBeans) session.getAttribute("loginUser");
    if (user == null) {
        response.sendRedirect("UsersLoginServlet");
        return;
    }
    
    Sayuki_Sakota sayuki = (Sayuki_Sakota) session.getAttribute("sayukiData");
    int love = (sayuki != null) ? sayuki.getLovePoint() : 0;
    int like = (sayuki != null) ? sayuki.getLikePoint() : 0;
%>
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>Profile - SAYUKI PORTAL</title>
<style>
/* --- 1. 全体設定（ポータルと統一） --- */
body { 
    margin: 0; padding: 0; background: #111; color: #fff;
    font-family: 'Helvetica Neue', 'Hiragino Kaku Gothic ProN', Arial, sans-serif;
    display: flex; justify-content: center; align-items: center; min-height: 100vh;
    background: linear-gradient(135deg, #2c3e50, #3498db); /* Profile用の背景色 */
}

/* --- 2. 戻るボタン --- */
.back-home {
    position: fixed; top: 20px; left: 20px; z-index: 1000;
    background: rgba(255, 105, 180, 0.8); color: white;
    padding: 10px 25px; text-decoration: none; border-radius: 30px;
    font-weight: bold; transition: 0.3s; box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
.back-home:hover { background: #ff1493; transform: scale(1.05); }

/* --- 3. ハンバーガーボタン --- */
.hamburger {
    position: fixed; top: 20px; right: 20px; width: 30px; height: 24px; 
    cursor: pointer; display: flex; flex-direction: column; justify-content: space-between;
    z-index: 2000;
}
.hamburger span {
    display: block; width: 100%; height: 3px;
    background-color: #fff; /* 背景が暗いので白に変更 */
    border-radius: 2px; transition: all 0.4s;
}
.active-btn span:nth-child(1) { transform: translateY(10.5px) rotate(45deg); }
.active-btn span:nth-child(2) { opacity: 0; }
.active-btn span:nth-child(3) { transform: translateY(-10.5px) rotate(-45deg); }

/* --- 4. 隠しメニュー --- */
.full-menu {
    position: fixed; top: 0; right: -100%; width: 300px; height: 100vh;
    background: rgba(0, 0, 0, 0.95); z-index: 1500;
    transition: 0.5s cubic-bezier(0.4, 0, 0.2, 1); padding-top: 100px;
}
.full-menu.active { right: 0; }
.full-menu ul { list-style: none; padding: 0; text-align: center; }
.full-menu ul li { margin-bottom: 30px; opacity: 0; transform: translateY(20px); transition: 0.5s; }
.full-menu.active ul li { opacity: 1; transform: translateY(0); }
.full-menu.active ul li:nth-child(1) { transition-delay: 0.2s; }
.full-menu.active ul li:nth-child(2) { transition-delay: 0.3s; }
.full-menu.active ul li:nth-child(3) { transition-delay: 0.4s; }
.full-menu.active ul li:nth-child(4) { transition-delay: 0.5s; }
.full-menu.active ul li:nth-child(5) { transition-delay: 0.6s; }
.full-menu ul li a { color: white; text-decoration: none; font-size: 1.5em; transition: 0.3s; }
.full-menu ul li a:hover { color: #ff69b4; }

/* --- 5. ガラスコンテナ (プロフィール本体) --- */
.glass-container {
    background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 20px;
    padding: 40px; width: 90%; max-width: 700px; margin-top: 60px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}
.glass-container h2 { border-left: 5px solid #ff69b4; padding-left: 15px; margin-top: 0; }
.info-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
.info-table th { text-align: left; color: #ff69b4; padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); width: 30%; }
.info-table td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); color: #eee; line-height: 1.6; }
.locked { color: #888; font-style: italic; font-size: 0.9em; }
</style>
</head>
<body>

    <a href="MainServlet" class="back-home">◀ PORTAL HOME</a>

    <div class="hamburger" id="ham-btn">
        <span></span> <span></span> <span></span>
    </div>

    <nav class="full-menu" id="full-menu">
        <ul>
            <li><a href="MainServlet">Portal Top</a></li>
            <li><a href="SayukiGameServlet">Atelier Game</a></li>
            <li><a href="ProfServlet">Official Profile</a></li>
            <li><a href="ArtServlet">Illustration Gallery</a></li>
            <li><a href="ItemServlet">Technical Tools</a></li>
        </ul>
    </nav>

    <div class="glass-container">
        <h2>Official Profile</h2>
        <table class="info-table">
            <tr>
                <th>名前</th>
                <td>迫田 サユキ（さこたん）</td>
            </tr>
            <tr>
                <th>職業</th>
                <td>イラストレーター</td>
            </tr>
            
            <tr>
                <th>愛用ツール</th>
                <td>
                    <% if (like >= 30) { %>
                        Blender, Live2D, Python（自動化スクリプト自作）
                    <% } else { %>
                        <span class="locked">🔒 信頼度(Like 30)で解禁されます</span>
                    <% } %>
                </td>
            </tr>
            
            <tr>
                <th>パーソナル</th>
                <td>
                    <% if (love >= 50) { %>
                        休日はもっぱらコーヒーを飲みながらコードを書いています。<br>
                        ……最近は、あなたと話す時間が一番の息抜きかも。
                    <% } else { %>
                        <span class="locked">🔒 親愛度(Love 50)で解禁されます</span>
                    <% } %>
                </td>
            </tr>
        </table>
    </div>

    <script>
    const hamBtn = document.getElementById('ham-btn');
    const menu = document.getElementById('full-menu');

    hamBtn.addEventListener('click', () => {
        menu.classList.toggle('active');
        hamBtn.classList.toggle('active-btn');
    });

    menu.addEventListener('click', () => {
        menu.classList.remove('active');
        hamBtn.classList.remove('active-btn');
    });
    </script>
</body>
</html>